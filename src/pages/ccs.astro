---
import Layout from '../layouts/Layout.astro';
import { getCcsData, CCS_MR_URL, type CcsComment } from '../lib/ccs';

const { proposal, threads } = await getCcsData();

const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const dateTimeFormat = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
  hour12: false,
});
const formatDate = (iso: string) => dateFormat.format(new Date(iso));
const formatDateTime = (iso: string) => `${dateTimeFormat.format(new Date(iso))} UTC`;

const comments: CcsComment[] = threads?.flatMap((thread) => thread.comments) ?? [];
const people = new Set(comments.map((comment) => comment.author.username)).size;
// The proposal names its authors by handle. Each known handle links to its GitHub profile.
const AUTHOR_GITHUB: Record<string, string> = {
  binarybaron: 'https://github.com/binarybaron',
  einliterflasche: 'https://github.com/Einliterflasche',
};
const authorParts = proposal ? proposal.authors.split(/(,\s*|\s+and\s+)/) : [];
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? '' : 's'}`;
const commentUrl = `${CCS_MR_URL}#note_form`;
---

<Layout
  title={proposal ? `${proposal.title} — eigenwallet CCS proposal` : 'CCS proposal — eigenwallet'}
  description="Our proposal for Monero community funding (CCS), with the full text and the discussion around it."
>
  <div class="ccs">
    <!-- One centred column. The contents list opens from a button in the corner. -->
    <header class="ccs-row">
      <div class="ccs-column">
        <h1 class="ccs-title">{proposal ? proposal.title : 'Our CCS proposal'}</h1>

        {proposal ? (
          <>
            <p class="ccs-lede">
              Proposed by
              {authorParts.map((part) =>
                AUTHOR_GITHUB[part.trim().toLowerCase()] ? (
                  <a href={AUTHOR_GITHUB[part.trim().toLowerCase()]} target="_blank" rel="noopener noreferrer">{part}</a>
                ) : (
                  part
                ),
              )}
              on {formatDate(proposal.createdAt)}
            </p>
          </>
        ) : (
          <p>
            We could not load the proposal from the Monero GitLab just now.
            <a href={CCS_MR_URL} target="_blank" rel="noopener noreferrer">Read it there.</a>
          </p>
        )}

        <p class="ccs-action">
          <a href={commentUrl} target="_blank" rel="noopener noreferrer" class="ccs-button">Comment on the proposal</a>
          <a href="#discussion" class="ccs-button ccs-button-quiet">View comments</a>
        </p>
      </div>
    </header>

    {proposal && (
      <div class="ccs-row">
        <article class="ccs-column ccs-prose" set:html={proposal.html} />
      </div>
    )}

    <section aria-labelledby="discussion">
      <div class="ccs-row">
        <div class="ccs-column ccs-prose">
          <h2 id="discussion">Discussion</h2>
          {threads && comments.length > 0 && (
            <p class="ccs-quiet">
              {plural(comments.length, 'comment')} from {plural(people, 'person').replace('persons', 'people')}.
              “Answer” opens a comment on the Monero GitLab, where you can reply to it.
            </p>
          )}
          {threads && comments.length === 0 && <p class="ccs-quiet">Nobody has commented yet.</p>}
          {!threads && (
            <p class="ccs-quiet">
              We could not load the comments just now.
              <a href={CCS_MR_URL} target="_blank" rel="noopener noreferrer">Read them on the Monero GitLab.</a>
            </p>
          )}
        </div>
      </div>

      {threads?.map((thread) => (
        <div class="ccs-thread">
          {thread.comments.map((comment, index) => (
            <article id={`note-${comment.id}`} class={`ccs-row ccs-comment ${index > 0 ? 'ccs-reply' : ''}`}>
              <header class="ccs-byline">
                <a href={comment.author.url} target="_blank" rel="noopener noreferrer nofollow" class="ccs-author">{comment.author.name}</a>
                {comment.isProposalAuthor && <span>proposer</span>}
                {index > 0 && <span>in reply to {thread.comments[0].author.name}</span>}
                <a href={comment.url} target="_blank" rel="noopener noreferrer">
                  <time datetime={comment.createdAt}>{formatDateTime(comment.createdAt)}</time>
                </a>
              </header>
              <div class="ccs-column">
                <div class="ccs-prose" set:html={comment.html} />
                <a
                  href={comment.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ccs-answer"
                  aria-label={`Answer ${comment.author.name}'s comment on the Monero GitLab`}
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 14 4 9 9 4" />
                    <path d="M20 20v-7a4 4 0 0 0-4-4H4" />
                  </svg>
                  Answer
                </a>
              </div>
            </article>
          ))}
        </div>
      ))}

      <div class="ccs-row ccs-close">
        <div class="ccs-column">
          <p class="ccs-action">
            <a href={commentUrl} target="_blank" rel="noopener noreferrer" class="ccs-button">Add your comment</a>
          </p>
        </div>
      </div>
    </section>

    {proposal && (
      <>
        <button type="button" class="ccs-contents-button" popovertarget="ccs-contents">Contents</button>
        <nav id="ccs-contents" popover class="ccs-contents" aria-label="Contents">
          <ul>
            {proposal.toc.map((entry) => (
              <li class={entry.depth > 3 ? 'ccs-toc-sub' : ''}>
                <a href={`#${entry.id}`} set:html={entry.html} />
              </li>
            ))}
            <li><a href="#discussion">Discussion</a></li>
          </ul>
        </nav>
      </>
    )}
  </div>
</Layout>

<script>
  // The contents list marks the section that is being read.
  const contents = document.getElementById('ccs-contents');
  const tocLinks = new Map<string, HTMLAnchorElement>();
  contents?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    tocLinks.set(decodeURIComponent(link.hash.slice(1)), link);
  });
  // Choosing a section closes the list.
  contents?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) contents.hidePopover();
  });
  const headings = [...tocLinks.keys()]
    .map((id) => document.getElementById(id))
    .filter((heading): heading is HTMLElement => heading !== null);

  function markCurrentSection() {
    // The current section is the last heading that has passed the top third of the window.
    const line = window.innerHeight / 3;
    let current: HTMLElement | undefined;
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= line) current = heading;
    }
    tocLinks.forEach((link, id) => {
      if (current?.id === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  if (headings.length > 0) {
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          markCurrentSection();
        });
      },
      { passive: true },
    );
    markCurrentSection();
  }

  // Long comments start collapsed. Without JavaScript they are shown in full.
  const COLLAPSED_LINES = 15;
  // A comment that is only a few lines longer than the limit is not worth collapsing.
  const SLACK_LINES = 5;

  document.querySelectorAll<HTMLElement>('.ccs-comment .ccs-prose').forEach((body) => {
    const lineHeight = parseFloat(getComputedStyle(body).lineHeight);
    if (!lineHeight || body.scrollHeight <= (COLLAPSED_LINES + SLACK_LINES) * lineHeight) return;

    body.style.maxHeight = `${COLLAPSED_LINES * lineHeight}px`;
    body.classList.add('ccs-collapsed');

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'ccs-expand';
    button.textContent = 'Show the whole comment';
    button.setAttribute('aria-expanded', 'false');
    body.after(button);

    button.addEventListener('click', () => {
      body.style.maxHeight = '';
      body.classList.remove('ccs-collapsed');
      button.remove();
      // Keep the keyboard position in the comment, now that the button is gone.
      body.tabIndex = -1;
      body.focus({ preventScroll: true });
    });
  });
</script>

<style is:global>
  /* Colours are the ones the rest of the site uses. Orange is for links and the one action. */
  .ccs {
    --ccs-accent: #f7a41d;
    --ccs-line: #333;
    --ccs-strong: #eee;
    --ccs-text: #cfcfcf;
    --ccs-quiet: #949494;
    --ccs-measure: 44rem;
    max-width: 62rem;
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
    color: var(--ccs-text);
    font-size: 1.0625rem;
  }
  .ccs [id] { scroll-margin-top: 1.5rem; }
  .ccs ::selection { background: var(--ccs-accent); color: #000; }
  .ccs a { color: var(--ccs-accent); text-decoration: none; text-underline-offset: 0.18em; }
  .ccs a:hover { text-decoration: underline; }
  .ccs a:focus-visible { outline: 2px solid var(--ccs-accent); outline-offset: 3px; }

  /* One centred column for the whole page */
  .ccs-row { max-width: var(--ccs-measure); margin-inline: auto; }

  /* Head of the document */
  .ccs-title {
    margin: 0 0 1rem;
    color: #fff;
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    .ccs-title { font-size: 2.375rem; }
  }
  .ccs-lede { margin: 0 0 1.75rem; color: var(--ccs-quiet); font-size: 1.0625rem; }
  .ccs .ccs-lede a { color: var(--ccs-strong); font-weight: 700; }
  .ccs-action {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 1.5rem 0 0;
  }
  .ccs a.ccs-button {
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    background: var(--ccs-accent);
    color: #000;
    font-size: 1rem;
    font-weight: 700;
    transition: background-color 0.15s ease-out;
  }
  .ccs a.ccs-button:hover { background: #ffb732; text-decoration: none; }
  .ccs a.ccs-button:active { background: #e0920f; }
  .ccs a.ccs-button-quiet { background: none; box-shadow: inset 0 0 0 1px #555; color: var(--ccs-strong); transition: box-shadow 0.15s ease-out; }
  .ccs a.ccs-button-quiet:hover { background: none; box-shadow: inset 0 0 0 1px var(--ccs-strong); }
  .ccs a.ccs-button-quiet:active { background: #1a1a1a; }

  /* Rendered markdown. Text, figures and tables all keep the one column, so nothing hangs out of it. */
  .ccs-row + .ccs-row, .ccs section { margin-top: 3.5rem; }
  .ccs-prose { line-height: 1.7; overflow-wrap: break-word; }
  .ccs-prose > :first-child { margin-top: 0; }
  .ccs-prose > :last-child { margin-bottom: 0; }
  .ccs-prose h2 { margin: 3.5rem 0 1rem; padding-top: 2rem; border-top: 1px solid var(--ccs-line); color: #fff; font-size: 1.625rem; line-height: 1.25; letter-spacing: -0.005em; }
  .ccs-prose > h2:first-child { padding-top: 0; border-top: 0; }
  .ccs-prose h3 { margin: 2.5rem 0 0.75rem; color: #fff; font-size: 1.25rem; line-height: 1.3; }
  .ccs-prose h4, .ccs-prose h5, .ccs-prose h6 { margin: 1.5rem 0 0.5rem; color: var(--ccs-strong); font-size: 1rem; }
  .ccs-prose p { margin: 0 0 1rem; }
  .ccs-prose strong { color: var(--ccs-strong); }
  .ccs-prose ul, .ccs-prose ol { margin: 0 0 1rem; padding-left: 1.5rem; }
  .ccs-prose ul { list-style: disc; }
  .ccs-prose ol { list-style: decimal; }
  .ccs-prose li { margin: 0.5rem 0; }
  .ccs-prose li::marker { color: var(--ccs-quiet); }
  .ccs-prose blockquote { margin: 0 0 1rem; padding-left: 1rem; border-left: 1px solid #555; color: var(--ccs-quiet); }
  .ccs-prose pre { margin: 0 0 1rem; padding: 0.9rem 1rem; overflow-x: auto; background: #1a1a1a; }
  .ccs-prose pre code { padding: 0; border: 0; background: none; }
  .ccs-prose figure { margin: 2rem 0; }
  .ccs-prose figure img { display: block; width: 100%; height: auto; border: 1px solid var(--ccs-line); border-radius: 8px; background: #fff; }
  .ccs-prose figcaption {
    margin-top: 0.7rem;
    color: var(--ccs-quiet);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .ccs-table { margin: 1.5rem 0; overflow-x: auto; border: 1px solid var(--ccs-line); border-radius: 8px; }
  .ccs-table table { width: 100%; margin: 0; border-collapse: collapse; }
  .ccs-table th, .ccs-table td { padding: 0.6rem 1rem; text-align: left; }
  .ccs-table th { border-bottom: 1px solid var(--ccs-line); background: #161616; color: var(--ccs-strong); font-size: 0.875rem; }
  .ccs-table tr + tr td { border-top: 1px solid var(--ccs-line); }
  .ccs-table th:not(:first-child), .ccs-table td:not(:first-child) {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ccs-quiet { color: var(--ccs-quiet); }

  /* Discussion: byline above each comment */
  .ccs-thread { max-width: var(--ccs-measure); margin: 2rem auto 0; padding-top: 2rem; border-top: 1px solid var(--ccs-line); }
  .ccs .ccs-thread .ccs-row { margin-top: 0; }
  .ccs-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--ccs-quiet);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .ccs .ccs-byline a { color: var(--ccs-quiet); }
  .ccs .ccs-byline a.ccs-author { color: var(--ccs-strong); font-size: 1rem; font-weight: 700; }
  .ccs .ccs-thread .ccs-reply { margin-top: 2rem; }
  .ccs-reply > .ccs-byline, .ccs-reply > .ccs-column { padding-left: 1.25rem; border-left: 1px solid #555; }
  .ccs-prose.ccs-collapsed {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 calc(100% - 4.5rem), transparent);
    mask-image: linear-gradient(#000 calc(100% - 4.5rem), transparent);
  }
  .ccs-prose:focus { outline: none; }
  .ccs-expand {
    margin: 1rem 1.5rem 0 0;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--ccs-accent);
    font: inherit;
    font-weight: 700;
    line-height: inherit;
    vertical-align: middle;
    cursor: pointer;
  }
  .ccs-expand:hover { text-decoration: underline; text-underline-offset: 0.18em; }
  .ccs-expand:focus-visible { outline: 2px solid var(--ccs-accent); outline-offset: 3px; }
  .ccs a.ccs-answer {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding: 0.25rem 0;
    font-weight: 700;
    vertical-align: middle;
  }

  .ccs .ccs-close { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--ccs-line); }
  .ccs-close .ccs-action { margin-top: 0; }

  /* Contents: a button in the corner that opens the list */
  .ccs-contents-button {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 5;
    padding: 0.6rem 1.1rem;
    border: 1px solid #555;
    border-radius: 6px;
    background: #1a1a1a;
    color: var(--ccs-strong);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.15s ease-out;
  }
  .ccs-contents-button:hover { border-color: var(--ccs-strong); }
  .ccs-contents-button:focus-visible { outline: 2px solid var(--ccs-accent); outline-offset: 3px; }
  .ccs-contents {
    position: fixed;
    inset: auto 1.5rem 5rem auto;
    width: min(20rem, calc(100vw - 3rem));
    max-height: 70vh;
    margin: 0;
    padding: 1.1rem;
    overflow-y: auto;
    border: 1px solid #555;
    border-radius: 8px;
    background: #1a1a1a;
    color: var(--ccs-text);
  }
  .ccs-contents ul { list-style: none; margin: 0; padding: 0; font-size: 0.9375rem; line-height: 1.35; }
  .ccs-contents li { margin: 0 0 0.6rem; }
  .ccs-contents li:last-child { margin-bottom: 0; }
  .ccs-contents .ccs-toc-sub { padding-left: 1rem; }
  .ccs .ccs-contents a { color: var(--ccs-quiet); }
  .ccs .ccs-contents a:hover { color: var(--ccs-strong); text-decoration: none; }
  .ccs .ccs-contents a[aria-current] { color: #fff; font-weight: 700; }
</style>
